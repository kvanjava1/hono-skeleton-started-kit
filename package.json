{
  "name": "hono-multi-db-api",
  "version": "1.0.0",
  "description": "Production-ready Hello World API with multi-database support (MySQL, MongoDB, SQLite)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "SERVICE_NAME=cli bun run scripts/migrate.ts up",
    "migrate:fresh": "SERVICE_NAME=cli bun run scripts/migrate.ts fresh",
    "seed": "SERVICE_NAME=cli bun run scripts/seed.ts",
    "make": "bun run scripts/make.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "dev:all": "concurrently \"bun run dev\" \"bun run dev:client\"",
    "build": "bun build ./src/index.ts --compile --outfile server",
    "dev": "SERVICE_NAME=app bun run --watch src/index.ts",
    "prod": "SERVICE_NAME=app bun run src/index.ts",
    "worker": "SERVICE_NAME=queue bun run src/workers/index.ts",
    "server:bin": "SERVICE_NAME=app ./server",
    "worker:bin": "SERVICE_NAME=queue ./server --worker"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.11.3",
    "bullmq": "^5.69.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "ioredis": "^5.9.3",
    "mongodb": "^7.1.0",
    "mysql2": "^3.12.0",
    "postgres": "^3.4.8",
    "prom-client": "^15.1.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "1.3.9",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.8"
  }
}
