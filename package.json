{
  "name": "hono-multi-db-api",
  "version": "1.0.0-beta.2",
  "description": "Production-ready Hello World API with multi-database support (MySQL, MongoDB, SQLite)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "SERVICE_NAME=cli bun run scripts/migrate.ts up",
    "migrate:fresh": "SERVICE_NAME=cli bun run scripts/migrate.ts fresh",
    "seed": "SERVICE_NAME=cli bun run scripts/seed.ts",
    "make": "bun run scripts/make.ts",
    "dev:css": "vite",
    "build:css": "vite build",
    "dev:all": "concurrently \"bun run server:code:dev\" \"bun run dev:css\"",
    "build:app": "bun build ./src/index.ts --compile --outfile server",
    "server:code:dev": "SERVICE_NAME=app bun run --watch src/index.ts",
    "server:code:prod": "SERVICE_NAME=app bun run src/index.ts",
    "worker:code:dev": "SERVICE_NAME=queue bun run --watch src/workers/index.ts",
    "worker:code:prod": "SERVICE_NAME=queue bun run src/workers/index.ts",
    "server:bin:prod": "NODE_ENV=production SERVICE_NAME=app ./server",
    "worker:bin:prod": "NODE_ENV=production SERVICE_NAME=queue ./server --worker"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.11.3",
    "bullmq": "^5.69.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "ioredis": "^5.9.3",
    "mongodb": "^7.1.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.8",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "1.4.2",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.8"
  }
}
